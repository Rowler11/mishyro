{
  "name": "Aishiteru",
  "short_name": "Aishiteru",
  "description": "App privada de pareja.",
  "lang": "es",
  "dir": "ltr",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#FBF4F3",
  "theme_color": "#FBF4F3",
  "categories": [
    "lifestyle"
  ],
  "icons": [
    {
      "src": "./icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Enviar amor",
      "short_name": "Amor",
      "url": "./#/inicio?amor=1",
      "icons": [
        {
          "src": "./icons/sc-amor-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Pregunta de hoy",
      "short_name": "Pregunta",
      "url": "./#/preguntas",
      "icons": [
        {
          "src": "./icons/sc-pregunta-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Pensando en ti",
      "short_name": "Pensando",
      "url": "./#/inicio?pensando=1",
      "icons": [
        {
          "src": "./icons/sc-pensando-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "image",
          "accept": [
            "image/*",
            ".png",
            ".webp",
            ".jpg",
            ".jpeg",
            ".gif"
          ]
        }
      ]
    }
  },
  "screenshots": [
    {
      "src": "./icons/screens/inicio.jpg",
      "sizes": "1080x1920",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Inicio: los días juntos, enviar amor y sus favoritos"
    },
    {
      "src": "./icons/screens/cartas.jpg",
      "sizes": "1080x1920",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Cartas: las que se escriben, con un gatito esperando"
    },
    {
      "src": "./icons/screens/mas.jpg",
      "sizes": "1080x1920",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Más: todas las secciones en grupos"
    },
    {
      "src": "./icons/screens/inicio-pc.jpg",
      "sizes": "1280x800",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Inicio en el computador"
    }
  ]
}
