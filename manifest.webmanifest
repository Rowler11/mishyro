{
  "name": "Aishiteru",
  "short_name": "Aishiteru",
  "description": "App privada de pareja.",
  "lang": "es",
  "dir": "ltr",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone"],
  "orientation": "any",
  "background_color": "#F6F1E7",
  "theme_color": "#C8412B",
  "categories": ["lifestyle"],
  "icons": [
    { "src": "./icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Pregunta de hoy", "short_name": "Pregunta", "url": "./#/preguntas", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Pensando en ti", "short_name": "Pensando", "url": "./#/inicio?pensando=1", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
